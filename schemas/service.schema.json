{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wolfsblvt/tunneltend/schemas/service.schema.json",
  "title": "TunnelTend registered service",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "enabled",
    "desiredState",
    "autostart",
    "watchdog",
    "tunnel",
    "mcp",
    "recovery"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "desiredState": {
      "enum": [
        "running",
        "stopped"
      ]
    },
    "autostart": {
      "type": "boolean"
    },
    "watchdog": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "organizationIds",
        "workspaceIds",
        "runtimeKeyRef"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "tunnelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "organizationIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "workspaceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "runtimeKeyRef": {
          "type": "string",
          "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:.+)$"
        },
        "adminProfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileName": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileDirectory": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mcp": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command"
          ],
          "properties": {
            "kind": {
              "const": "command"
            },
            "command": {
              "$ref": "#/$defs/command"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "commandString"
          ],
          "properties": {
            "kind": {
              "const": "commandString"
            },
            "commandString": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "url"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          }
        }
      ]
    },
    "host": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "file",
            "arguments",
            "workingDirectory",
            "environment"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workingDirectory": {
              "type": [
                "string",
                "null"
              ]
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:.+)$"
              }
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "enabled": {
              "type": "boolean"
            },
            "stopTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            }
          }
        }
      ]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "readyUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "startupTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "watch": {
          "type": "boolean"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "debounceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxAttempts",
        "windowMinutes",
        "initialBackoffSeconds",
        "maximumBackoffSeconds",
        "unhealthyThreshold"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "windowMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "initialBackoffSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maximumBackoffSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "unhealthyThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "command": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/command"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "arguments",
        "workingDirectory",
        "environment"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workingDirectory": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:.+)$"
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    }
  }
}
