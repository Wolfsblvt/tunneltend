{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wolfsblvt/tunneltend/schemas/output.schema.json",
  "title": "TunnelTend CLI JSON envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "product_version",
    "timestamp",
    "command",
    "status",
    "message",
    "data",
    "diagnostics",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product": {
      "const": "tunneltend"
    },
    "product_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "command": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "degraded",
        "error",
        "planned",
        "changed",
        "noop"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
