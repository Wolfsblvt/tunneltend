---
// SPDX-License-Identifier: AGPL-3.0-only
// #day: a day with TunnelTend, on a violet-slate band. Six moments on one cyan rail, each a
// thing you would otherwise do by hand, each with the real state word and the real default.
// The defaults are the registration defaults (recovery 4 attempts in a 20-minute window,
// unhealthy after 2 checks, 10 s debounce) and the task schedule (logon +20 s, every 2 min,
// daily 05:15). The edges collect in one line at the end, where they belong.
import Icon from '../Icon.astro';
import SectionHead from '../SectionHead.astro';
import SectionLinks from '../SectionLinks.astro';
import type { IconName } from '../../data/icons';
import { docPaths } from '../../data/site';
const moments: { time: string; icon: IconName; title: string; body: string; state: string; kind: 'ok' | 'degraded' | 'neutral' }[] = [
  { time: '07:58', icon: 'power', title: 'You sign in.', body: 'With the default delay, the Startup task begins after twenty seconds and starts eligible services with sign-in startup enabled. You do not have to open their terminals.', state: 'desired=running observed=ready', kind: 'ok' },
  { time: '08:00', icon: 'eye', title: 'Every two minutes, a look.', body: 'The Watchdog compares what should be running with what is. Most of the day the answer is “nothing to do”, and it does nothing.', state: 'No problems detected.', kind: 'ok' },
  { time: '10:42', icon: 'refresh', title: 'Your tool stops responding.', body: 'A running service that fails two health checks becomes eligible for recovery. TunnelTend stops only a process it can prove it owns and records each attempt, with backoff and a default limit of 4 in a 20-minute window.', state: 'recovered · attempt 1 of 4', kind: 'degraded' },
  { time: '12:30', icon: 'pause', title: 'You stop one on purpose.', body: 'tunneltend service stop photo-tagger --session-only. The Watchdog leaves it alone until your next sign-in. A stop is intent, not a failure to repair.', state: 'suppressed this session', kind: 'neutral' },
  { time: '13:10', icon: 'file-text', title: 'You edit the source.', body: 'A registered project folder is watched on the watchdog’s schedule, every two minutes by default. A detected change must stay stable through the ten-second debounce before a restart. Watching does not build or pull code.', state: 'restarted after debounce', kind: 'ok' },
  { time: '05:15', icon: 'download', title: 'The official client gets newer.', body: 'Maintenance finds a stable openai/tunnel-client release, verifies its published digest, stages it, swaps it in and restores the fleet. If anything fails, it rolls back and tells you.', state: 'client 0.0.17 verified', kind: 'ok' },
];
---
<section class="section day" data-section="day">
  <div class="wrap">
    <SectionHead id="day" title="A day with TunnelTend" body="Everything on this line is something you would otherwise do by hand, remember to do, or discover was not done when ChatGPT said your tool was unavailable." />
    <ol class="rail" aria-label="A day with TunnelTend">
      {moments.map(moment => (
        <li class="moment">
          <span class="node" aria-hidden="true"><Icon name={moment.icon} size={22} /></span>
          <span class="time">{moment.time}</span>
          <h3 class="moment-title">{moment.title}</h3>
          <p class="moment-body">{moment.body}</p>
          <span class="state" data-state={moment.kind}>{moment.state}</span>
        </li>
      ))}
    </ol>
    <p class="edges"><strong>What it won’t do, on purpose:</strong> keep serving while the PC sleeps or nobody is signed in, run git pull, builds or migrations for you, touch a process it cannot prove it owns, host anything, or bundle the official client.</p>
    <SectionLinks links={[['Everyday operation', docPaths.operations], ['Service state explained', docPaths.serviceState], ['Official client updates and rollback', docPaths.updates]]} />
  </div>
</section>

<style>
  /* the band bleeds to the viewport; the content stays on the page grid */
  .day { background: var(--bg-slate); border-top: 0; position: relative; }
  .day::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 1px; background: color-mix(in srgb, var(--accent) 35%, transparent); }
  html[data-theme="dark"] .day { --bg-raised: #3d3848; --hair: #4a4455; --hair-strong: #5c5668; }
  .rail { position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px; margin: 12px 0 0; padding: 0; list-style: none; }
  /* the cyan rail behind the nodes, round-capped like the Fold */
  .rail::before { content: ""; position: absolute; left: 26px; right: 26px; top: 26px; height: 3px; border-radius: 3px; background: var(--accent); opacity: .9; }
  .moment { position: relative; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .node { display: inline-flex; width: 54px; height: 54px; align-items: center; justify-content: center; border-radius: 50%; background: var(--bg-slate); border: 3px solid var(--accent); color: var(--accent-text); flex: none; position: relative; z-index: 1; }
  html[data-theme="dark"] .node { color: var(--accent); }
  .time { font-family: var(--font-mono); font-size: 12px; color: var(--fg-3); margin-top: 6px; }
  .moment-title { font-size: 17px; font-weight: 600; }
  .moment-body { margin: 0; font-size: 13.5px; line-height: 1.55; color: var(--fg-2); }
  .moment .state { margin-top: auto; padding-top: 6px; font-size: 12px; }
  .edges { margin: 8px 0 0; padding: 14px 16px; border: 1px dashed var(--hair-strong); border-radius: var(--r-block); font-size: 13.5px; color: var(--fg-2); max-width: 76ch; }
  .edges strong { color: var(--fg); }
  @media (max-width: 1100px) { .rail { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 36px; } .rail::before { display: none; } }
  @media (max-width: 640px) {
    .rail { grid-template-columns: minmax(0, 1fr); row-gap: 28px; padding-left: 0; }
    .rail::before { display: block; left: 26px; right: auto; top: 26px; bottom: 26px; width: 3px; height: auto; }
    .moment { padding-left: 70px; }
    .node { position: absolute; left: 0; top: 0; }
    .time { margin-top: 0; }
  }
</style>
