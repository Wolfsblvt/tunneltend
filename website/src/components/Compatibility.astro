---
// SPDX-License-Identifier: AGPL-3.0-only
import { loadCompatibility } from '../data/compatibility';
import { evidenceAge } from '../../../tools/compatibility/evidence-model.mjs';

const facts = loadCompatibility();
const releaseGroup = facts.groups.find(group => group.kind === 'release' && group.architecture === 'amd64');
const latest = releaseGroup?.newest;
const age = latest ? evidenceAge(latest.checkedAt) : null;
const layers = [
  ['distribution', 'Distribution'],
  ['credentialFreeCli', 'Credential-free CLI'],
  ['localFleet', 'Owned fleet restored'],
  ['connectedConsumer', 'Connected consumer'],
] as const;
const changes = facts.identityHistory.identities.filter(item => item.changes.length > 0);
const shortHash = (value: string | null) => value?.slice(0, 12) ?? 'unavailable';
const formatDate = (value: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(value));
const formatDateTime = (value: string) => new Intl.DateTimeFormat('en-GB', {
  dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC',
}).format(new Date(value));
const outcomeLabel = (value: string) => value === 'not exercised'
  ? 'Not exercised'
  : value.charAt(0).toUpperCase() + value.slice(1);
---
<aside class="compatibility" aria-labelledby="compatibility-title" data-compatibility data-website-source={facts.websiteCommit}>
  <div class="compatibility-heading">
    <h3 id="compatibility-title">Official-client checks</h3>
    <a class="link-quiet" href="https://github.com/Wolfsblvt/tunneltend/actions/workflows/upstream-compatibility.yml">Check history</a>
  </div>
  <p class="compatibility-intro">Dated checks of OpenAI’s Windows client. TunnelTend verifies releases locally; this report never grants or blocks an update.</p>

  <section class="compatibility-summary" data-compatibility-summary aria-label="Latest released client summary">
    <div class="compatibility-summary-heading">
      <div>
        <p class="compatibility-eyebrow">Latest released client · Windows x64</p>
        <h4>{latest?.release?.tag ?? 'Release evidence unavailable'}</h4>
      </div>
      <p class="compatibility-release-date">
        {latest?.release?.publishedAt
          ? <>Published <time datetime={latest.release.publishedAt}>{formatDate(latest.release.publishedAt)}</time></>
          : 'Publication date unavailable'}
      </p>
    </div>
    <ul class="compatibility-outcomes" aria-label="Four compatibility outcomes">
      {layers.map(([key, label]) => <li data-compatibility-outcome={key}>
        <span>{label}</span>
        <strong>{outcomeLabel(latest?.[key].outcome ?? 'unavailable')}</strong>
      </li>)}
    </ul>
    {latest && age && <p class="compatibility-time">
      Observed <time datetime={latest.observedAt}>{formatDateTime(latest.observedAt)}</time>
      · checked <time datetime={latest.checkedAt}>{formatDateTime(latest.checkedAt)}</time>
      · <span data-evidence-age={latest.checkedAt}>{age.hours}h old at build{age.stale ? ' · stale (48h)' : ''}</span>
    </p>}
    {!latest && <p class="compatibility-time">No valid retained Windows x64 release report is available in this build. Local installation and updates remain independent.</p>}
  </section>

  {changes.length > 0 && <p class="compatibility-warning" role="note" data-same-tag-warning>
    <strong>Same-tag asset changes need maintainer judgment.</strong>
    Existing same-version installations keep their current bytes.
  </p>}

  <details class="compatibility-details" data-compatibility-details>
    <summary>Evidence details, source builds and identity history</summary>
    {facts.groups.map(group => {
      const item = group.newest;
      const qualified = group.qualified;
      const architecture = group.architecture === 'amd64' ? 'Windows x64' : 'Windows ARM64';
      const packageKind = group.kind === 'release' ? 'Released TunnelTend package' : 'Current source build';
      return <section class="compatibility-group">
        <h4>{packageKind} · {architecture}</h4>
        <p class="compatibility-build">
          Tested TunnelTend {item.package.version ?? 'version unavailable'} · package <code>{shortHash(item.package.sha256)}</code>
          {item.package.sourceCommit && <> · source <code>{shortHash(item.package.sourceCommit)}</code></>}
        </p>
        <dl>
          <div><dt>Newest observed</dt><dd>{item.release?.tag ?? 'Release unavailable'}{item.asset && <> · {item.asset.name} · <code>{item.asset.sha256 ? shortHash(item.asset.sha256) : 'checksum unavailable'}</code></>}</dd></div>
          <div><dt>Last routine-qualified</dt><dd>{qualified ? <>{qualified.release?.tag} · <code>{shortHash(qualified.asset?.sha256 ?? null)}</code> · TunnelTend {qualified.package.version} ({qualified.package.kind}) · <time datetime={qualified.checkedAt}>{formatDateTime(qualified.checkedAt)}</time> · <a class="link-quiet" href={qualified.evidence.artifactUrl}>evidence #{qualified.evidence.artifactId}</a> · <span data-evidence-expiry={qualified.evidence.expiresAt}>retained at build; expires {formatDateTime(qualified.evidence.expiresAt)}</span></> : 'Unavailable in retained evidence'}</dd></div>
        </dl>
        <ul class="compatibility-outcomes" aria-label={`Separate evidence boundaries for ${packageKind}, ${architecture}`}>
          {layers.map(([key, label]) => <li><span>{label}</span><strong>{outcomeLabel(item[key].outcome)}</strong></li>)}
        </ul>
        <p class="compatibility-time">
          Observed <time datetime={item.observedAt}>{formatDateTime(item.observedAt)}</time><br />
          Checked <time datetime={item.checkedAt}>{formatDateTime(item.checkedAt)}</time> · <span data-evidence-age={item.checkedAt}>{evidenceAge(item.checkedAt).hours}h old at build</span><br />
          Execution: {item.execution}. {group.architecture === 'arm64' && item.execution !== 'native' && 'Asset verification does not establish ARM64 execution.'}
        </p>
        <details>
          <summary>Exact report, hashes and checks</summary>
          <p><a class="link-quiet" href={item.evidence.runUrl}>Run {item.evidence.runId}, attempt {item.evidence.attempt}</a> · <a class="link-quiet" href={item.evidence.artifactUrl}>artifact {item.evidence.artifactId}</a> · qualifier job {item.evidence.qualificationConclusion} · run outcome {item.evidence.conclusion}</p>
          <p><span data-evidence-expiry={item.evidence.expiresAt}>Retained at build; artifact expires {formatDateTime(item.evidence.expiresAt)}.</span> Qualification source <code>{item.source.commit}</code>; harness <code>{item.source.harnessSha256}</code>; adapter <code>{item.source.adapterSha256 ?? 'unavailable'}</code>.</p>
          <p>Official asset SHA-256 <code>{item.asset?.sha256 ?? 'unavailable'}</code>. Tested package SHA-256 <code>{item.package.sha256 ?? 'unavailable'}</code>.</p>
          {layers.map(([key, label]) => <p><strong>{label}:</strong> {item[key].checks.map(check => `${check.id}: ${outcomeLabel(check.outcome)}`).join('; ') || 'No checks exercised'}</p>)}
        </details>
      </section>;
    })}
    {changes.length > 0 && <section class="compatibility-changes">
      <h4>Same-tag identity history</h4>
      <p>These retained observations show the first observed baseline and each changed asset. A repeat check does not resolve the change.</p>
      <ul>{changes.map(item => <li>{item.tag} · {item.architecture} · baseline <code>{shortHash(item.baseline.sha256)}</code> → {item.changes.map(asset => <><code>{shortHash(asset.sha256)}</code> · first observed <time datetime={asset.observedAt}>{formatDateTime(asset.observedAt)}</time> · <a class="link-quiet" href={`https://github.com/Wolfsblvt/tunneltend/actions/runs/${asset.runId}`}>run {asset.runId}</a> </>)}</li>)}</ul>
    </section>}
    {!facts.historyAvailable && <p class="compatibility-time">Earlier same-tag history is unavailable; no clean historical baseline is inferred.</p>}
    {facts.historyAvailable && <p class="compatibility-time">History covers retained observations only; predecessors before each baseline’s first observation remain unknown.</p>}
    {facts.issues.length > 0 && <p class="compatibility-time">Retained-data notices: {facts.issues.join(', ')}. Missing, expired, invalid or inaccessible reports are not successful checks.</p>}
    {facts.websiteCommit && <p class="compatibility-time">Website source <code>{facts.websiteCommit}</code> · built <time datetime={facts.builtAt}>{formatDateTime(facts.builtAt!)}</time>.</p>}
  </details>
</aside>

<script>
  function refreshAges() {
    for (const element of document.querySelectorAll<HTMLElement>('[data-evidence-age]')) {
      const hours = Math.max(0, Math.floor((Date.now() - Date.parse(element.dataset.evidenceAge!)) / 3_600_000));
      element.textContent = `${hours}h old${hours >= 48 ? ' · stale (48h)' : ''}`;
    }
    for (const element of document.querySelectorAll<HTMLElement>('[data-evidence-expiry]')) {
      if (Date.now() >= Date.parse(element.dataset.evidenceExpiry!)) element.textContent = 'Expired — this historical check is no longer retained.';
    }
  }
  refreshAges();
  window.addEventListener('pageshow', refreshAges);
</script>

<style>
  .compatibility { margin-top: 24px; padding: 20px; border: 1px solid var(--hair); border-radius: var(--r-block); background: var(--bg-raised); font-size: 14px; }
  .compatibility-heading, .compatibility-summary-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .compatibility h3 { margin: 0; font-size: 17px; }
  .compatibility h4 { margin: 0; font-size: 16px; }
  .compatibility p { margin: 10px 0 0; }
  .compatibility-intro, .compatibility-build { color: var(--fg-2); }
  .compatibility-summary { margin-top: 14px; padding: 16px; border: 1px solid var(--hair); border-radius: var(--r-block); background: var(--bg); }
  .compatibility-eyebrow { margin: 0 0 4px !important; color: var(--fg-2); font-size: 12px; }
  .compatibility-release-date { color: var(--fg-2); font-size: 13px; }
  .compatibility-outcomes { padding: 0; margin: 12px 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 24px; }
  .compatibility-outcomes li { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--hair); padding: 6px 0; }
  .compatibility-outcomes strong { white-space: nowrap; font-weight: 600; }
  .compatibility-time { font-size: 12px; line-height: 1.65; color: var(--fg-2); }
  .compatibility-warning { margin-top: 12px !important; padding: 10px 12px; border-left: 3px solid var(--accent); background: var(--bg-raised-2); color: var(--fg-2); }
  .compatibility-warning strong { color: var(--fg); }
  .compatibility-details { margin-top: 12px; font-size: 13px; }
  .compatibility-details > summary, .compatibility-group details > summary { cursor: pointer; color: var(--accent-text); }
  .compatibility-group { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--hair); }
  .compatibility-group > h4 { margin-bottom: 8px; }
  .compatibility-group details { margin-top: 12px; font-size: 12px; }
  .compatibility-group p { overflow-wrap: anywhere; }
  .compatibility-group dl { display: grid; gap: 8px; margin: 14px 0; }
  .compatibility-group dl > div { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 12px; }
  .compatibility-group dt { color: var(--fg-2); }
  .compatibility-group dd { margin: 0; overflow-wrap: anywhere; }
  .compatibility-group time, .compatibility-details code { overflow-wrap: anywhere; }
  .compatibility-changes { margin-top: 18px; border-top: 1px solid var(--hair); padding-top: 16px; }
  .compatibility-changes ul { margin: 8px 0 0; padding-left: 20px; }
  @media (max-width: 650px) {
    .compatibility-summary { padding: 14px; }
    .compatibility-outcomes { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .compatibility-group dl > div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }
</style>
