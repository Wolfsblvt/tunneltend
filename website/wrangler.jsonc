{
  // The TunnelTend website: Cloudflare Workers Static Assets from the Astro build. No custom
  // Worker script; the static assets are the whole site. tunneltend.com is a Cloudflare zone,
  // so the Workers route (not Pages) is the adopted Wolf Ops split for a dedicated domain.
  //
  // Desired routing only: no provider resource or DNS effect occurs until Wolf Ops admits
  // the Home and supplies the production workflow inputs. Provider/preview aliases remain
  // disabled so the production build has one selected public Home.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tunneltend-website",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tunneltend.com", "custom_domain": true }],
  "assets": {
    "directory": "./artifacts/site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": false }
}
